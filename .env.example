# StudyPulse Environment Variables
# Copy this file to .env and fill in your values

# Canvas Configuration (optional - can also be entered in the app UI)
CANVAS_DOMAIN=yourschool.instructure.com
CANVAS_TOKEN=your_canvas_api_token_here

# Anthropic API Key (for AI-powered reminders)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# SMS / Text Message Settings (T-Mobile gateway)
STUDENT_NAME=YourName
PHONE_NUMBER=2015551234
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx
SMS_ENABLED=true

# Server Port (default: 3000)
PORT=3000
